    "places_empty": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz öğrenilen yer yok. Stillway sizi birkaç gün izleyecek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ学習した場所はありません。Stillwayが数日かけて学びます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No learned places yet. Stillway will watch for a few days."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lieu appris pour l’instant. Stillway observera quelques jours."
          }
        }
      }
    },
    "place_label_title": {
      "localizations": {
        "tr": {
          "stringUnit": {
