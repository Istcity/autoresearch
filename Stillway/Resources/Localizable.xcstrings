        }
      }
    },
    "place_label_subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yeri tanımlarsanız Stillway otomatik mod açabilir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所を指定すると、Stillwayが自動モードを使えます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you label this place, Stillway can turn on auto mode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous nommez ce lieu, Stillway pourra activer le mode auto."
          }
        }
      }
    },
