    "onboard_headline1": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillway seni öğreniyor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillwayはあなたを学びます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillway is learning you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillway apprend à vous connaître."
          }
        }
      }
    },
    "onboard_body1": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerede olduğunu, ne yaptığını anlıyor. Sen hiçbir şey seçmeden doğru müziği açıyor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこにいて、何をしているかを理解します。選ばなくても、正しい音が始まります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It understands where you are and what you’re doing. The right sound starts without you choosing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comprend où vous êtes et ce que vous faites. Le bon son démarre sans que vous choisissiez."
          }
        }
      }
    },
    "onboard_title2": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulaklık Tak, Gerisi Bize Kalır"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イヤホンをつければ、あとは任せて"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put on Headphones. We’ll Handle the Rest"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez vos écouteurs. On s’occupe du reste"
          }
        }
      }
    },
    "onboard_headline2": {
      "localizations": {
        "tr": {
          "stringUnit": {
